<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Shown only while the accessibility service is off. -->
        <LinearLayout
            android:id="@+id/warn_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="The accessibility service is off. Nothing is being blocked."
                android:textColor="#B00020"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Open Accessibility Settings" />
        </LinearLayout>

        <!-- Feature 1 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Skip Shorts / Reels"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:text="Presses back when the full-screen Shorts or Reels player opens." />

        <Switch
            android:id="@+id/sw_shorts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="On" />

        <EditText
            android:id="@+id/et_shorts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Minutes (blank = until I switch it off)"
            android:inputType="number"
            android:maxLength="4" />

        <TextView
            android:id="@+id/tv_shorts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="Off"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="24dp"
            android:layout_marginTop="24dp"
            android:background="#20000000" />

        <!-- Feature 2 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lock apps"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:text="Sends you home whenever a locked app opens." />

        <Switch
            android:id="@+id/sw_lock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="On" />

        <EditText
            android:id="@+id/et_lock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Minutes (blank = until I switch it off)"
            android:inputType="number"
            android:maxLength="4" />

        <TextView
            android:id="@+id/tv_lock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="Off"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cb_youtube"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="YouTube" />

        <CheckBox
            android:id="@+id/cb_instagram"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Instagram" />

    </LinearLayout>

</ScrollView>
