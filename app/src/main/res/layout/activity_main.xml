<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Shown only while the accessibility service is off. -->
        <LinearLayout
            android:id="@+id/warn_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Service is off. Nothing is being blocked."
                android:textColor="#B00020"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Open Accessibility Settings" />
        </LinearLayout>

        <!-- Feature 1 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Block Shorts, Reels &amp; TikTok"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:text="Backs out of Shorts and Reels, and stops the Instagram and TikTok feeds from scrolling." />

        <Switch
            android:id="@+id/sw_shorts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="On" />

        <TextView
            android:id="@+id/tv_shorts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="Off"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_feed_instagram"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_learn_instagram"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Set up Instagram feed" />

        <TextView
            android:id="@+id/tv_feed_tiktok"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_learn_tiktok"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Set up TikTok feed" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="Each feed snaps back to the top instead of scrolling. On TikTok that leaves you on the first video, and Inbox, Profile and search keep working normally."
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="24dp"
            android:layout_marginTop="24dp"
            android:background="#20000000" />

        <!-- Feature 2 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lock apps"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:text="Sends you home when a locked app opens." />

        <Switch
            android:id="@+id/sw_lock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="On" />

        <TextView
            android:id="@+id/tv_lock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="Off"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cb_youtube"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="YouTube" />

        <CheckBox
            android:id="@+id/cb_instagram"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Instagram" />

        <CheckBox
            android:id="@+id/cb_tiktok"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TikTok" />

        <CheckBox
            android:id="@+id/cb_discord"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Discord" />

        <CheckBox
            android:id="@+id/cb_dnd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Also turn on Do Not Disturb" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="32dp"
            android:text="Alarms and starred contacts still ring."
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="24dp"
            android:layout_marginTop="24dp"
            android:background="#20000000" />

        <!-- Feature 3 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pause blocking"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:text="Lifts everything above for a set time, counts it down in the notification, then puts it all back by itself. The switches stay on the whole time." />

        <EditText
            android:id="@+id/et_pause"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Minutes"
            android:inputType="number"
            android:maxLength="4" />

        <Button
            android:id="@+id/btn_pause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Pause" />

        <TextView
            android:id="@+id/tv_pause"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:textStyle="bold" />

        <!-- Shown only during a pause, so a pause is never a one-way door. -->
        <Button
            android:id="@+id/btn_resume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Resume blocking now"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
