<?xml version="1.0" encoding="utf-8"?>
<!-- This XML declares the MAXIMUM the service may ever ask for. The service narrows
     eventTypes down at runtime with setServiceInfo() - see BlockerService.applyEventTypes().

     packageNames is the single biggest battery saving in the app: the system filters
     on it BEFORE any IPC into our process, so events from every other app on the
     phone cost us literally nothing. Add another app by editing this line (and the
     package constants in Prefs.kt).

     This is the maximum set; the service narrows it further at runtime to only the
     apps a live feature can act on, which is what keeps Discord out of the filter
     unless it is actually locked, and TikTok out until its feed has been set up.

     TikTok is listed twice on purpose: the worldwide build and the build shipped in
     some regions and as TikTok Lite use different package names, and which one is
     installed is not knowable from here.

     notificationTimeout=500 makes the system coalesce content-changed events to at
     most one per 500ms, on its side, so scrolling a feed cannot flood us. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewScrolled"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:description="@string/service_description"
    android:notificationTimeout="500"
    android:packageNames="com.google.android.youtube,com.instagram.android,com.discord,com.zhiliaoapp.musically,com.ss.android.ugc.trill,com.chess,com.naver.linewebtoon" />
